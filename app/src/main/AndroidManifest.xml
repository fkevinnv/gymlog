<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.GymLog">

        <activity
            android:name=".ui.principal.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.rutina.RutinaActivity"
            android:exported="false" />

        <!-- Vertical fijo para no perder el estado del temporizador al girar -->
        <activity
            android:name=".ui.entrenamiento.EntrenamientoActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
    </application>

</manifest>
